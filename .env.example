# Copy to .env for local development. `.env` is gitignored and must never be
# committed (CLAUDE.md §7.5); production reads these from the corporate secret
# manager rather than from a file in the image (03-auth-security.md §11).
#
# These values match infra/compose.yaml, so the defaults work against
# `make dev` with no edits.

WEBMAP_ENVIRONMENT=local

# The application role. It must NOT have BYPASSRLS — the API asserts that at
# startup and refuses to boot (03-auth-security.md §3.5).
WEBMAP_DATABASE_URL=postgresql+asyncpg://webmap_app:webmap@localhost:5432/webmap
# Migrations run as a separate privileged role (02-data-model.md §4).
WEBMAP_MIGRATION_DATABASE_URL=postgresql+psycopg://webmap_migrator:webmap@localhost:5432/webmap

WEBMAP_REDIS_URL=redis://localhost:6379/0

WEBMAP_S3_ENDPOINT=http://localhost:9000
WEBMAP_S3_BUCKET=webmap
WEBMAP_S3_ACCESS_KEY=minioadmin
WEBMAP_S3_SECRET_KEY=minioadmin

WEBMAP_TITILER_URL=http://localhost:8001

# Signing key for scoped tile tokens (03-auth-security.md §6). The default in
# settings.py is a placeholder and the app refuses to start in prod with it.
WEBMAP_TILE_TOKEN_SECRET=dev-only-not-a-secret

# Identity. Empty locally until the IdP is confirmed in week 1 — Entra ID or
# on-prem AD (adr/0007-multi-user-directory-sso.md).
WEBMAP_OIDC_DISCOVERY_URL=
WEBMAP_OIDC_CLIENT_ID=
WEBMAP_OIDC_CLIENT_SECRET=

# The local MCP server. Fixed at install time, never switchable at runtime
# (03-auth-security.md §4.5).
WEBMAP_MCP_API_BASE_URL=http://localhost:8000
