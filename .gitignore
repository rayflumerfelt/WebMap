# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
coverage.xml
htmlcov/

# --- Node -------------------------------------------------------------------
node_modules/
dist/
dist-types/
.turbo/
*.tsbuildinfo
.vite/

# --- Secrets and local config -----------------------------------------------
# CLAUDE.md §7.5: never commit secrets, .env files, or real data.
.env
.env.*
!.env.example
*.pem
*.key

# --- Data and artifacts -----------------------------------------------------
# tests/fixtures/ is synthetic and IS committed. These are not.
/data/
*.gpkg-shm
*.gpkg-wal

# Visual regression output. Goldens under tests/visual/golden/ ARE committed;
# regenerate them deliberately with `make update-goldens` (CLAUDE.md §7.5).
tests/visual/output/

# Playwright
playwright-report/
test-results/

# --- OS and editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Render shell build outputs. Built by `make render-shell` locally and by the
# node stage of infra/docker/render.Dockerfile in CI. Not committed: a vendored
# maplibre-gl.js would drift from the version the app renders with, which is
# the divergence screenshotting the page exists to prevent.
apps/render/shell/maplibre-gl.js
apps/render/shell/maplibre-gl.css
apps/render/shell/overlay.js
apps/render/shell/overlay.js.map

# Host-side DuckDB extension cache for restricted networks. Binaries, ~100 MB,
# and version-specific — fetched with `make duckdb-extensions`, never committed.
.duckdb-extensions/

# Downloaded font sources. Re-fetched by `make fonts`; the glyph ranges built
# from them ARE committed (infra/glyphs), because an air-gapped deployment
# cannot rebuild them and a map with no glyphs draws no labels at all.
.fonts/
